# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF for terraform, yaml, shell, and java
*.tf text eol=lf
*.tfvars text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.java text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
